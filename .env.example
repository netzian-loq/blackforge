# ─────────────────────────────────────────────────────────────────────────────
# Lead delivery
#
# Until these are set, quote requests are validated and written to the function
# logs but no email is sent. Set all three in the Vercel project (Production,
# Preview and Development) before pointing the domain at the site.
# ─────────────────────────────────────────────────────────────────────────────

# API key from https://resend.com — Vercel Marketplace can also provision this.
RESEND_API_KEY=

# The address quote requests are sent TO. Falls back to `site.email`.
QUOTE_TO_EMAIL=quotes@backforgerepair.com

# The address quote requests are sent FROM. Must be on a domain verified in
# Resend, otherwise delivery is rejected. Not the customer's address — their
# email is set as reply-to so a reply goes straight back to them.
QUOTE_FROM_EMAIL=website@backforgerepair.com
