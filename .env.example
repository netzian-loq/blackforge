# ─────────────────────────────────────────────────────────────────────────────
# Lead delivery
#
# Until these are set, quote requests are validated and written to the function
# logs but no email is sent. Set all three in the Vercel project (Production,
# Preview and Development) before pointing the domain at the site.
# ─────────────────────────────────────────────────────────────────────────────

# API key from https://resend.com — Vercel Marketplace can also provision this.
RESEND_API_KEY=

# The address quote requests are sent TO. Falls back to `site.email`.
QUOTE_TO_EMAIL=blackforgerepair@gmail.com

# The address quote requests are sent FROM. This cannot be the gmail address:
# Resend only sends from a domain you have verified with it. Until there is a
# domain, use Resend's test sender `onboarding@resend.dev`, which delivers only
# to the email on the Resend account. Not the customer's address either — theirs
# is set as reply-to so a reply goes straight back to them.
QUOTE_FROM_EMAIL=onboarding@resend.dev

# ─────────────────────────────────────────────────────────────────────────────
# Site URL
#
# Canonical tags, sitemap.xml, robots.txt and the social cards all read this.
# Set it in Vercel as soon as the project exists — to the .vercel.app URL at
# first, then to the real domain once it is attached.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://blackforge.vercel.app
